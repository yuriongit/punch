{
  // The protocol used for all requests in this load test.
  "protocol": "http",

  // The base URL that receives the generated requests.
  "target": "localhost:3000/api/lilify/v1/urls",

  // Allows the test duration to vary by up to 10 percent for timeouts, etc.
  "grace_period_percent": 0,

  // A single Punch configuration can contain multiple request definitions.
  "children": [
    {
      // The name of the child (the path) is appended to the target URL.
      "name": "/pokemon/pikachu",

      // Sends a GET request to the configured target.
      "method": "GET",

      // Sends 10 total requests during this test.
      "total_requests": 5,

      // The requests are distributed across a two-second test duration.
      "base_duration_secs": 5,
    },
    {
      // Demonstration of errors with an inexistant path.
      "name": "/pokemon/fake-pikachu",
      "method": "GET",
      "total_requests": 15,
      "base_duration_secs": 5,
      
      // If a request returns the wanted status code, that request is successfull.
      "want_status_code": 404 // defaults to 200
    }
  ]
}
